{
  "name": "beasiswaapp",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r --if-present build",
    "check-types": "pnpm -r check-types",
    "dev:gateway": "pnpm --filter api-gateway dev",
    "dev:rbac": "pnpm --filter @beasiswaapp/service-rbac dev",
    "dev:master": "pnpm --filter @beasiswaapp/service-master dev",
    "dev:transaksi": "pnpm --filter @beasiswaapp/service-transaksi dev",
    "dev:dokumen": "pnpm --filter @beasiswaapp/service-dokumen dev",
    "dev:web": "pnpm --filter web dev",
    "db:generate": "pnpm -r --if-present run db:generate",
    "db:push": "pnpm -r --if-present run db:push",
    "db:start": "docker compose up -d mysql postgres",
    "db:stop": "docker compose stop mysql postgres",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "split:repos": "powershell -File scripts/split-repos.ps1",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@beasiswaapp/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@beasiswaapp/config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "catalog:",
    "ultracite": "7.10.7"
  },
  "packageManager": "pnpm@10.33.2"
}
