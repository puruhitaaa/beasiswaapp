{
  "name": "beasiswaapp",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r --if-present build",
    "check-types": "pnpm -r check-types",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "db:push": "pnpm --filter @beasiswaapp/db db:push",
    "db:studio": "pnpm --filter @beasiswaapp/db db:studio",
    "db:generate": "pnpm --filter @beasiswaapp/db db:generate",
    "db:migrate": "pnpm --filter @beasiswaapp/db db:migrate",
    "db:start": "docker compose up -d mysql",
    "db:watch": "docker compose up mysql",
    "db:stop": "docker compose stop mysql",
    "db:down": "docker compose down mysql",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@beasiswaapp/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@beasiswaapp/config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "catalog:",
    "ultracite": "7.10.7"
  },
  "packageManager": "pnpm@10.33.2"
}
