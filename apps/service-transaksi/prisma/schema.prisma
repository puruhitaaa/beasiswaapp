generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "mysql"
}

model Pendaftaran {
  id                   String                       @id @default(cuid())
  kodePermohonan       String                       @unique @db.VarChar(64)
  userId               String                       @db.VarChar(64)
  beasiswaId           String                       @db.VarChar(64)
  beasiswaNamaSnapshot String?                      @db.VarChar(255)
  status               String                       @default("DRAFT") @db.VarChar(32)
  stepWizardTerakhir   Int                          @default(1)
  submittedAt          DateTime?
  biodata              BiodataPendaftar?
  pendidikan           RiwayatPendidikanPekerjaan?
  dokumen              DokumenPendaftaran[]
  verifikasi           VerifikasiAdministrasi?
  wawancara            PenilaianWawancara?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  @@index([userId])
  @@index([beasiswaId])
  @@index([status])
  @@map("pendaftaran")
}

model BiodataPendaftar {
  id            String      @id @default(cuid())
  pendaftaranId String      @unique
  pendaftaran   Pendaftaran @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)
  nik           String      @db.VarChar(16)
  namaLengkap   String      @db.VarChar(255)
  tempatLahir   String?     @db.VarChar(100)
  tglLahir      String      @db.VarChar(10)
  jenisKelamin  String?     @db.VarChar(10)
  alamat        String      @db.Text
  provinsi      String?     @db.VarChar(100)
  kabupatenKota String?     @db.VarChar(100)
  kecamatan     String?     @db.VarChar(100)
  kelurahan     String?     @db.VarChar(100)
  noHp          String      @db.VarChar(20)
  noWa          String      @db.VarChar(20)
  email         String      @db.VarChar(255)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("biodata_pendaftar")
}

model RiwayatPendidikanPekerjaan {
  id                 String      @id @default(cuid())
  pendaftaranId      String      @unique
  pendaftaran        Pendaftaran @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)
  pendidikanTerakhir String      @db.VarChar(32)
  namaInstansi       String      @db.VarChar(255)
  jurusan            String      @db.VarChar(255)
  pekerjaanSaatIni   String      @db.VarChar(100)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@map("riwayat_pendidikan_pekerjaan")
}

model VerifikasiAdministrasi {
  id                   String      @id @default(cuid())
  pendaftaranId        String      @unique
  pendaftaran          Pendaftaran @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)
  verifikatorId        String      @db.VarChar(64)
  checklistKtp         Boolean     @default(false)
  checklistKk          Boolean     @default(false)
  checklistIjazah      Boolean     @default(false)
  checklistRekomendasi Boolean     @default(false)
  catatanRevisi        String?     @db.Text
  statusKeputusan      String      @db.VarChar(32)
  verifiedAt           DateTime    @default(now())
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@map("verifikasi_administrasi")
}

model PenilaianWawancara {
  id              String      @id @default(cuid())
  pendaftaranId   String      @unique
  pendaftaran     Pendaftaran @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)
  interviewerId   String      @db.VarChar(64)
  nilaiWawancara  Float
  catatanEvaluasi String      @db.Text
  statusHasil     String      @db.VarChar(32)
  evaluatedAt     DateTime    @default(now())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("penilaian_wawancara")
}

model DokumenPendaftaran {
  id              String      @id @default(cuid())
  pendaftaranId   String
  pendaftaran     Pendaftaran @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)
  persyaratanId   String      @db.VarChar(64)
  namaPersyaratan String?     @db.VarChar(255)
  dokumenId       String?     @db.VarChar(64)
  fileName        String      @db.VarChar(255)
  fileSize        String?     @db.VarChar(32)
  mimeType        String?     @db.VarChar(64)
  format          String?     @db.VarChar(16)
  fileUrl         String?     @db.VarChar(512)
  isSesuai        Boolean     @default(true)
  isRejected      Boolean     @default(false)
  catatanRevisi   String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([pendaftaranId, persyaratanId])
  @@index([pendaftaranId])
  @@map("dokumen_pendaftaran")
}
